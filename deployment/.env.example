# Stage 4 Open WebUI / Ollama settings (copy to .env and adjust)

MODEL_NAME=databricks-study-notes
WEBUI_PORT=3000
OLLAMA_PORT=11434
QUANT=Q4_K_M

# Single-user laptop: no signup wall
WEBUI_AUTH=false

# Where Open WebUI finds Ollama:
#   Host Ollama (Option A / Mac Metal stand-in) — recommended for laptop demos:
OLLAMA_BASE_URL=http://host.docker.internal:11434
#   Full Docker stack (GGUF registered inside Compose ollama service):
# OLLAMA_BASE_URL=http://ollama:11434
