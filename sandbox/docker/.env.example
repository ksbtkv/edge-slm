# Copy to .env and edit. The Makefile loads it automatically.

# Pin the Ollama runtime version for reproducibility.
OLLAMA_TAG=0.5.7

# Hard memory cap — the project's 16 GB system-RAM target.
MEM_LIMIT=16g
MEMSWAP_LIMIT=18g

# Models to benchmark (comma-separated). Empty = the 4 Stage 0 candidates.
# Stage 0 primary is qwen2.5:3b.
MODELS=qwen2.5:3b
